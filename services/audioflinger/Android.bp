

cc_library_shared {
    name: "libaudioflinger",
    // PICO: the factory image has the audio server libraries only in 64 bits (64-bit
    // audioserver, AUDIOSERVER_MULTILIB 64); no 32-bit variant is built or installed.
    compile_multilib: "64",

    srcs: [
        "AudioDumpUtils.cpp",
        "AudioFlinger.cpp",
        "AudioHwDevice.cpp",
        "AudioStreamOut.cpp",
        "AudioWatchdog.cpp",
        "BufLog.cpp",
        "Effects.cpp",
        "FastCapture.cpp",
        "FastCaptureDumpState.cpp",
        "FastCaptureState.cpp",
        "FastMixer.cpp",
        "FastMixerDumpState.cpp",
        "FastMixerState.cpp",
        "FastThread.cpp",
        "FastThreadDumpState.cpp",
        "FastThreadState.cpp",
        "HapticEffect.cpp",
        "NBAIO_Tee.cpp",
        "PatchPanel.cpp",
        "SpdifStreamOut.cpp",
        "StateQueue.cpp",
        "Threads.cpp",
        "Tracks.cpp",
        "TypedLogger.cpp",
    ],

    include_dirs: [
        "frameworks/av/services/audiopolicy",
        "frameworks/av/services/medialog",
    ],

    shared_libs: [
        // PICO: audio event tracking (factory libaudioeventtracking.so), first as in the
        // factory DT_NEEDED list.
        "libaudioeventtracking",
        "libaudiohal",
        "libaudioprocessing",
        "libaudiospdif",
        "libaudioutils",
        "libcutils",
        "libutils",
        "liblog",
        "libbinder",
        "libaudioclient",
        "libmedialogservice",
        "libmediametrics",
        "libmediautils",
        "libnbaio",
        "libnblog",
        "libpowermanager",
        "libmediautils",
        "libmemunreachable",
        "libmedia_helper",
        "libvibrator",
    ],

    header_libs: ["libaudioeventtracking_headers"],
    // AudioFlinger.h includes it; audioserver includes AudioFlinger.h.
    export_header_lib_headers: ["libaudioeventtracking_headers"],

    static_libs: [
        "libcpustats",
        "libsndfile",
    ],

    cflags: [
        "-DSTATE_QUEUE_INSTANTIATIONS=\"StateQueueInstantiations.cpp\"",
        "-fvisibility=hidden",
        "-Werror",
        "-Wall",
    ],
    sanitize: {
        integer_overflow: true,
    },

}
