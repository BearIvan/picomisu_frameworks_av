cc_library_shared {
    name: "libmedialogservice",
    // PICO: the factory image has the audio server libraries only in 64 bits (64-bit
    // audioserver, AUDIOSERVER_MULTILIB 64); no 32-bit variant is built or installed.
    compile_multilib: "64",

    srcs: [
        "IMediaLogService.cpp",
        "MediaLogService.cpp",
    ],

    shared_libs: [
        "libaudioutils",
        "libbinder",
        "liblog",
        "libmediautils",
        "libnblog",
        "libutils",
    ],

    cflags: [
        "-Werror",
        "-Wall",
    ],
}
